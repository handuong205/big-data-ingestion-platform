MINIO_ROOT_USER=bigdataadmin
MINIO_ROOT_PASSWORD=replace_with_a_strong_password
MINIO_BUCKET=raw-data
# Bucket của tầng processed (Parquet sạch + bad_records), tách riêng khỏi raw
MINIO_PROCESSED_BUCKET=processed-data

POSTGRES_DB=bigdata
POSTGRES_USER=bigdata
POSTGRES_PASSWORD=replace_with_a_strong_password

SPARK_WORKER_CORES=2
SPARK_WORKER_MEMORY=2G
SPARK_EXECUTOR_MEMORY=1536m
SPARK_DRIVER_MEMORY=1g

# Host-side values (scripts run on your machine: ingest.py, local Spark tests).
# docker-compose.yml overrides these inside the Spark containers.
SPARK_MASTER_URL=local[*]
MINIO_ENDPOINT=http://localhost:9000
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

RAW_BOOKS_PATH=data/raw/books_data.csv
RAW_REVIEWS_PATH=data/raw/Books_rating.csv
PROCESSED_DIR=data/processed
BAD_RECORDS_DIR=data/bad_records

KAGGLE_API_TOKEN=replace_with_your_kaggle_api_token
KAGGLE_USERNAME=replace_with_your_kaggle_username

# Thư mục cache của KaggleHub. Mặc định code dùng <repo>/data/kagglehub.
# Bỏ comment dòng dưới nếu muốn đổi sang chỗ khác (dùng đường dẫn tuyệt đối).
# KAGGLEHUB_CACHE=C:/duong/dan/cache

# Ngưỡng số review tối thiểu cho Q2 (top tác giả / nhà xuất bản)
MIN_REVIEWS_Q2=30
